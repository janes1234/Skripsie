\contentsline {figure}{\numberline {4.3}{\ignorespaces Overview of the Atlantis, Cape Flats, Waterval, Fisantekraal, and Northern Works WWTW facilities.}}{21}{figure.caption.18}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces One example of each aerobic zone class, with the facility it comes from. Each example is the test image of the chronological split (Section~\ref {sec:exp_mixed}) that all four pretrained models classified correctly with the highest mean confidence, so that it is a clear case of its class.}}{22}{figure.caption.19}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces One example of each clarifier class, with the facility it comes from, chosen in the same way as in Figure~\ref {fig:aerobic_examples}. The area outside each tank is masked to black by the preparation script (Section~\ref {sec:pipeline}).}}{22}{figure.caption.20}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Number of clarifier images from each facility in the training, development and test sets when Waterval is held out. The test set contains only Waterval, while the remaining four facilities are split into training and development sets.}}{26}{figure.caption.22}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces A relabelled clarifier from Cape Flats, shown with some of its surroundings. The original label was ``Scum'', but the label was corrected to ``Empty'', since the tank appears to be drained, with its floor and the shadow of the bridge visible inside it.}}{28}{figure.caption.23}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces The relabelling interface, showing the original label and the per-class correction buttons.}}{29}{figure.caption.24}%
