\@writefile{lot}{\contentsline {table}{\numberline {2.2}{\ignorespaces Structure of DenseNet-121 for a $224\times 224$ input, with columns as in Table~\ref {tab:resnet_layers}. Each dense layer is a $1\times 1$ convolution followed by a $3\times 3$ convolution, and a range such as 64--224 means that the number of input channels grows by $k=32$ with each dense layer. Batch normalisation and ReLU precede each convolution and the global average pool, except for convolution 1, which they follow.}}{8}{table.caption.12}\protected@file@percent }
\newlabel{tab:densenet_layers}{{2.2}{8}{Structure of DenseNet-121 for a $224\times 224$ input, with columns as in Table~\ref {tab:resnet_layers}. Each dense layer is a $1\times 1$ convolution followed by a $3\times 3$ convolution, and a range such as 64--224 means that the number of input channels grows by $k=32$ with each dense layer. Batch normalisation and ReLU precede each convolution and the global average pool, except for convolution 1, which they follow}{table.caption.12}{}}
