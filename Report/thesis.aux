\@writefile{lot}{\contentsline {table}{\numberline {2.1}{\ignorespaces Structure of ResNet-18 for a $224\times 224$ input. Each row is one layer or a group of identical consecutive layers. Kernel gives the dimensions of one kernel, Num the number of kernels, and $s$ and $p$ the stride and padding (Equation~\ref {eq:conv_output_size}). Shortcut rows are not counted in the 18 layers. In each block, the second ReLU is applied after the shortcut is added. Params includes batch normalisation. The parameter counts in this and the following tables are from torchvision \citep  {torchvision2016}, with the 1000-class ImageNet output layer.}}{7}{table.caption.11}\protected@file@percent }
\newlabel{tab:resnet_layers}{{2.1}{7}{Structure of ResNet-18 for a $224\times 224$ input. Each row is one layer or a group of identical consecutive layers. Kernel gives the dimensions of one kernel, Num the number of kernels, and $s$ and $p$ the stride and padding (Equation~\ref {eq:conv_output_size}). Shortcut rows are not counted in the 18 layers. In each block, the second ReLU is applied after the shortcut is added. Params includes batch normalisation. The parameter counts in this and the following tables are from torchvision \citep {torchvision2016}, with the 1000-class ImageNet output layer}{table.caption.11}{}}
\newlabel{tab:resnet_layers@cref}{{[table][1][2]2.1}{[1][7][]7}{}{}{}}
