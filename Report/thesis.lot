\contentsline {table}{\numberline {4.3}{\ignorespaces Summary of image counts per class for the Aerobic Zones.}}{23}{table.caption.24}%
\contentsline {table}{\numberline {4.4}{\ignorespaces Summary of image counts per class for the Clarifiers.}}{23}{table.caption.24}%
\addvspace {10\p@ }
\contentsline {table}{\numberline {5.1}{\ignorespaces Parameter count of each of the four architectures evaluated, from smallest to largest, as defined in torchvision with the original 1000-class ImageNet classifier. The new classifier heads (Section~\ref {sec:exp_hyperparams}) change these totals.}}{26}{table.caption.26}%
\contentsline {table}{\numberline {5.2}{\ignorespaces Number of training images per clarifier class and the resulting class weight $w_c$, for each held-out test facility and for the chronological split.}}{28}{table.caption.28}%
\contentsline {table}{\numberline {5.3}{\ignorespaces Number of training images per aerobic zone class and the resulting class weight $w_c$, for each held-out test facility and for the chronological split.}}{29}{table.caption.29}%
\contentsline {table}{\numberline {5.4}{\ignorespaces Search range of each tuned hyperparameter, and the values used for each architecture and component, with the development accuracy on the selected trial. The learning rate is sampled log-uniformly, $N$ from $\{512, 1024, 2048\}$ and the batch size from $\{8, 16, 24, 32, 48, 64, 96, 128\}$. $H{=}0$ means the classifier head is a single linear layer, and $N$ is unused.}}{30}{table.caption.30}%
\contentsline {table}{\numberline {5.5}{\ignorespaces Number of images per class in the training, development and test sets of the chronological split used in Experiment~1. The test set contains every image captured from January 2020 onwards.}}{32}{table.caption.32}%
\contentsline {table}{\numberline {5.6}{\ignorespaces Number of training, development and test images for each held-out facility, and the number of test images per class. The test set is the held-out facility, and the training and development sets are drawn from the remaining facilities.}}{33}{table.caption.33}%
\addvspace {10\p@ }
\contentsline {table}{\numberline {6.1}{\ignorespaces Macro-averaged test set recall and mean AUC of every architecture for the chronological split (Exp.~1) and averaged across held-out facilities (Exp.~2, mean $\pm $ standard deviation). Each test image is assigned to the class with the highest softmax probability, so no decision threshold is used. The macro recall is the unweighted mean of the per-class recalls on the test set, over the classes that occur in it. Experiment~1 has a single test set, so no standard deviation is given. $\Delta $ is the change in the macro recall from Experiment~1 to Experiment~2, in percentage points.}}{38}{table.caption.34}%
\contentsline {table}{\numberline {6.2}{\ignorespaces Test set recall of every failure class on the chronological split (Exp.~1) and averaged across the held-out facilities at which the class occurs (Exp.~2). Each test image is assigned to the class with the highest softmax probability, so no decision threshold is used.}}{39}{table.caption.35}%
\contentsline {table}{\numberline {6.3}{\ignorespaces Binary OK / Not-OK results of every architecture on the chronological split (Exp.~1) and averaged across held-out facilities (Exp.~2). The AUC does not depend on a threshold. The recall, specificity and precision of the Not-OK class are given on the test set, at the threshold chosen for a Not-OK recall of 95\% on the development set (Section~\ref {sec:exp_binary}). The thresholds themselves are listed in Appendix~\ref {appen:res_binary}.}}{40}{table.caption.37}%
\contentsline {table}{\numberline {6.4}{\ignorespaces Not-OK recall and specificity for each held-out facility at the threshold chosen for a Not-OK recall of 95\% on the corresponding development set, for the ConvNeXt-Tiny clarifier model and the DenseNet-121 aerobic zone model. A full set of results of all architectures is given in Appendix~\ref {appen:res_binary}.}}{41}{table.caption.38}%
\contentsline {table}{\numberline {6.5}{\ignorespaces Test results on the chronological split with (Aug.) and without (None) augmentation during training. As in Table~\ref {tab:res_multiclass}, each test image is assigned to the class with the highest softmax probability, so no decision threshold is used for the accuracy or the macro recall. $\Delta $ is the difference in percentage points, where a positive value means that augmentation helped.}}{41}{table.caption.39}%
